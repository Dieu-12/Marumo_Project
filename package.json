{
  "name": "marumo-quality",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test scripts/quality/*.test.mjs scripts/handoff/*.test.mjs marumo_web/src/utils/bookingLogic.test.js marumo_web/src/utils/storedValue.test.js marumo_admin/src/utils/utils.test.mjs",
    "test:ui": "playwright test",
    "lint": "node scripts/quality/lint.mjs",
    "check": "node scripts/handoff/cli.mjs verify",
    "quality": "node scripts/quality/run.mjs",
    "handoff:init": "node scripts/handoff/cli.mjs init",
    "handoff:verify": "node scripts/handoff/cli.mjs verify",
    "handoff:check": "node scripts/handoff/cli.mjs check",
    "handoff:render": "node scripts/handoff/cli.mjs render",
    "handoff:ci": "node scripts/handoff/cli.mjs ci",
    "test:quality": "node --test scripts/quality/*.test.mjs",
    "hooks:install": "node scripts/quality/install-hooks.mjs",
    "handoff:recover": "node scripts/handoff/cli.mjs recover"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "mssql": "^12.8.0",
    "parse5": "^8.1.1",
    "postcss": "^8.5.33",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "private": true
}
