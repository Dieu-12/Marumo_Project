{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request",
    "snapshot",
    "files",
    "checks",
    "deployment"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "baseCommit",
        "taskIds",
        "outcome",
        "goal",
        "mainFiles",
        "risks",
        "limitations"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$"
          }
        },
        "outcome": {
          "enum": [
            "completed",
            "partial",
            "blocked"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "mainFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change",
          "blob",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "change": {
            "enum": [
              "added",
              "modified",
              "deleted"
            ]
          },
          "blob": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "enum": [
              "100644",
              "100755",
              "120000",
              null
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "enum": [
              "quality",
              "db"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        }
      }
    },
    "deployment": {
      "const": "not_performed"
    }
  }
}
