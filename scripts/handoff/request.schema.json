{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseCommit",
    "taskIds",
    "outcome",
    "goal",
    "mainFiles",
    "risks",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "taskIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]+$"
      }
    },
    "outcome": {
      "enum": [
        "completed",
        "partial",
        "blocked"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "mainFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
